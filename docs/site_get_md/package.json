  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "cheerio": "^1.2.0",
    "mysql2": "^3.16.2",
    "playwright": "^1.41.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
