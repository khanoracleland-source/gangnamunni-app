<script>
var DEF = <?php echo $def_json; ?>;
var cur = <?php echo $cur_json; ?>;
var dirty = false;

function applyPreview(){
  var f=document.getElementById('pv'); if(!f||!f.contentDocument) return;
  var doc=f.contentDocument;
  var min=parseFloat(cur.fs_mobile_min), slope=parseFloat(cur.fs_mobile_slope), base=parseFloat(cur.fs_mobile_base), os=parseFloat(cur.fs_os_scale);
  var vw = 340/100;
  var calc = base + slope*vw*100;
  var scale = Math.max(min, Math.min(calc, 1.0)) * os;
  var sid='__fs_preview_style';
  var s=doc.getElementById(sid);
  if(!s){ s=doc.createElement('style'); s.id=sid; doc.head.appendChild(s); }
  s.textContent=':root{ --fs-scale:'+scale.toFixed(3)+' !important; }';
}
function onSlide(key,v){
  document.getElementById('val_'+key).textContent=v;
  cur[key]=v; markDirty(); applyPreview();
}
function markDirty(){ dirty=true; document.getElementById('dirty').style.display='inline'; }
function resetOne(key){
  cur[key]=DEF[key];
  document.getElementById('rng_'+key).value=DEF[key];
  document.getElementById('val_'+key).textContent=DEF[key];
  markDirty(); applyPreview();
}
function resetAll(){ for(var k in DEF){ if(document.getElementById('rng_'+k)) resetOne(k); } }
function pvPage(p,btn){
  document.querySelectorAll('.pv-tools button').forEach(function(b){b.classList.remove('on')});
  if(btn)btn.classList.add('on');
  var f=document.getElementById('pv'); f.src=p;
}
function pvReload(){ var f=document.getElementById('pv'); f.src=f.src; }
document.getElementById('pv').addEventListener('load', applyPreview);

function saveAll(){
  var keys=Object.keys(cur); var done=0, fail=0;
  keys.forEach(function(key){
    var fd=new FormData(); fd.append('key',key); fd.append('value',cur[key]);
    fetch('api_save_font_scale.php',{method:'POST',body:fd,credentials:'same-origin'})
      .then(function(r){return r.json()}).then(function(j){
        done++; if(!j.success) fail++;
        if(done===keys.length){
          if(fail===0){ dirty=false; document.getElementById('dirty').style.display='none'; toast('저장 완료 — 사이트에 적용됨'); pvReload(); }
          else toast('일부 저장 실패('+fail+'건)');
        }
      }).catch(function(){done++;fail++; if(done===keys.length)toast('저장 오류');});
  });
}
function toast(m){ var t=document.getElementById('toast'); t.textContent=m; t.classList.add('show'); setTimeout(function(){t.classList.remove('show')},2200); }
</script>
