// 서울미녀 hms_saas ERD — dbdiagram.io / DBML import용 (2026-06-12)
// 생성: 스키마 덤프 파싱 + FK/명명규칙 관계 추론. https://dbdiagram.io 에 붙여넣기 하면 ERD 표시됨.

Table accountants {
  "id" int(10) [pk]
  "user_id" bigint(20)
  "tenant_id" varchar(191)
  "created_at" timestamp
  "updated_at" timestamp
}

Table accounts {
  "id" int(10) [pk]
  "name" varchar(160)
  "type" tinyint(4)
  "description" text
  "status" tinyint(1)
  "tenant_id" varchar(191)
  "created_at" timestamp
  "updated_at" timestamp
}

Table addon_app_admin_app_images {
  "image_id" int(11) [pk]
