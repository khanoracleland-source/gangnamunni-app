    <!-- 하단 네비게이션 -->
    <?php include __DIR__ . '/includes/bottom_navigation.php'; ?>

    <script>
        // 뷰 전환 기능
        function switchView(viewType) {
            const grid = document.getElementById('hospital-grid');
            const cardBtn = document.getElementById('view-card');
            const listBtn = document.getElementById('view-list');

            if (viewType === 'list') {
                grid.classList.add('list-view');
                cardBtn.classList.remove('active');
                listBtn.classList.add('active');
            } else {
                grid.classList.remove('list-view');
                cardBtn.classList.add('active');
                listBtn.classList.remove('active');
            }

            // 로컬스토리지에 사용자 설정 저장
            localStorage.setItem('hospital_view', viewType);
        }

        // 페이지 로드 시 저장된 뷰 적용
        document.addEventListener('DOMContentLoaded', function() {
            const savedView = localStorage.getItem('hospital_view');
            if (savedView === 'list') {
                switchView('list');
            }
        });

        // 스크롤 컨테이너 좌우 이동
        function scrollContainer(selector, amount) {
            const container = document.querySelector(selector);
            if (!container) return;

            const startPosition = container.scrollLeft;
            const targetPosition = startPosition + amount;
            const duration = 500;
            let startTime = null;

            function animation(currentTime) {
                if (startTime === null) startTime = currentTime;
                const timeElapsed = currentTime - startTime;
                const progress = Math.min(timeElapsed / duration, 1);

                // easeInOutQuad 애니메이션
                const ease = progress < 0.5
                    ? 2 * progress * progress
                    : 1 - Math.pow(-2 * progress + 2, 2) / 2;

                container.scrollLeft = startPosition + ((targetPosition - startPosition) * ease);

                if (timeElapsed < duration) {
                    requestAnimationFrame(animation);
                }
            }

            requestAnimationFrame(animation);
        }

        function showImportGuide() {
            alert(`
데이터베이스 Import 가이드:

1. MySQL 접속:
   mysql -u root -p -h 124.111.85.242

2. hairwang 데이터베이스 선택:
   USE hairwang;

3. SQL 파일 import:
   SOURCE H:/carebaby_project/site_get/gangnamunni_hospitals_import.sql;

4. 완료 후 이 페이지 새로고침 (F5)

문제 발생 시: test_db_connection.php에서 DB 연결 확인
            `);
        }

        // 시술 카테고리 필터
        function filterByCategory(category) {
            location.href = 'hospitals.php?category=' + encodeURIComponent(category);
        }

        // 지역 필터
        function filterByRegion(region) {
            if (region === '') {
                location.href = 'index.php';
            } else {
                location.href = 'hospitals.php?q=' + encodeURIComponent(region);
            }
        }

        // 검색 기능
        document.querySelector('.search-input').addEventListener('keyup', function(e) {
            if (e.key === 'Enter') {
                const keyword = this.value.trim();
                if (keyword) {
                    location.href = 'hospitals.php?q=' + encodeURIComponent(keyword);
                }
            }
        });

        // 네비게이션 아이템 클릭
        document.querySelectorAll('.nav-item').forEach(item => {
            item.addEventListener('click', function() {
                const page = this.getAttribute('data-page');
                if (page && page !== '#') {
                    location.href = page;
                }
            });
        });

        // 수평 자동 스크롤 기능
        function initAutoScroll(containerSelector, enabled, interval) {
            if (!enabled || enabled === '0') return;

            const container = document.querySelector(containerSelector);
            if (!container) return;

            const scrollInterval = parseInt(interval) || 10000;
            let isScrolling = false;

            function smoothScrollTo(targetPosition) {
                if (isScrolling) return;
                isScrolling = true;

                const startPosition = container.scrollLeft;
                const distance = targetPosition - startPosition;
                const duration = 800; // 0.8초 동안 스크롤
                let startTime = null;

                function animation(currentTime) {
                    if (startTime === null) startTime = currentTime;
                    const timeElapsed = currentTime - startTime;
                    const progress = Math.min(timeElapsed / duration, 1);

                    // easeInOutQuad 애니메이션
                    const ease = progress < 0.5
                        ? 2 * progress * progress
                        : 1 - Math.pow(-2 * progress + 2, 2) / 2;

                    container.scrollLeft = startPosition + (distance * ease);

                    if (timeElapsed < duration) {
                        requestAnimationFrame(animation);
                    } else {
                        isScrolling = false;
                    }
                }

                requestAnimationFrame(animation);
            }

            function autoScroll() {
                const maxScroll = container.scrollWidth - container.clientWidth;

                if (container.scrollLeft >= maxScroll - 10) {
                    // 끝에 도달하면 처음으로
                    smoothScrollTo(0);
                } else {
                    // 한 아이템 너비만큼 이동
                    const itemWidth = container.querySelector('.ad-item, .promo-banner')?.offsetWidth || 300;
                    const gap = 12; // CSS gap 값
                    const scrollAmount = itemWidth + gap;
                    smoothScrollTo(container.scrollLeft + scrollAmount);
                }
            }

            // 자동 스크롤 시작
            let scrollTimer = setInterval(autoScroll, scrollInterval);

            // 사용자가 수동으로 스크롤하면 타이머 초기화
            container.addEventListener('scroll', function() {
                clearInterval(scrollTimer);
                scrollTimer = setInterval(autoScroll, scrollInterval);
            }, { passive: true });

            // 마우스 호버시 자동 스크롤 일시정지
            container.addEventListener('mouseenter', function() {
                clearInterval(scrollTimer);
            });

            container.addEventListener('mouseleave', function() {
                scrollTimer = setInterval(autoScroll, scrollInterval);
            });
        }

        // 페이지 로드 후 자동 스크롤 초기화
        document.addEventListener('DOMContentLoaded', function() {
            // 광고 배너 자동 스크롤
            initAutoScroll('.ads-banner-wrapper', '<?php echo $ad_auto_scroll_enabled; ?>', '<?php echo $ad_auto_scroll_interval; ?>');

            // 프로모션 배너 자동 스크롤
            initAutoScroll('.promo-wrapper', '<?php echo $promo_auto_scroll_enabled; ?>', '<?php echo $promo_auto_scroll_interval; ?>');
        });
    </script>
</body>
</html>
