# ========================================
# 환경 변수 설정 파일 (예시)
# ========================================
#
# 이 파일을 .env로 복사한 후 실제 값을 입력하세요
# cp .env.example .env
#
# ⚠️ 보안 경고:
# - .env 파일은 절대 Git에 커밋하지 마세요
# - .gitignore에 .env를 추가하세요
# - 파일 권한을 600으로 설정하세요: chmod 600 .env

# ========================================
# 푸시 알림 API 키
# ========================================
PUSH_API_KEY=replace-with-at-least-32-random-characters

# ========================================
# Firebase 설정
# ========================================
# Firebase 서비스 계정 JSON 파일 경로 (절대 경로 권장)
FIREBASE_JSON_PATH=/path/to/firebase-service-account.json

# Firebase 프로젝트 ID
FIREBASE_PROJECT_ID=your-project-id

# ========================================
# 푸시 알림 기본 설정
# ========================================
# 기본 토픽 이름
DEFAULT_TOPIC=news_test

# 기본 URL (푸시 클릭 시 이동할 기본 주소)
DEFAULT_URL=https://yourdomain.com

# 발신자 이름 (arg3)
DEFAULT_SENDER=MARS

# ========================================
# 데이터베이스 설정 (선택사항)
# ========================================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=hairwang

# ========================================
# 관리자 계정 (선택사항)
# ========================================
# 관리자 아이디
ADMIN_USERNAME=admin

# 관리자 비밀번호 해시 (generate_password_hash.php로 생성)
ADMIN_PASSWORD_HASH=$2y$10$YourHashHere

# ========================================
# SNS OAuth API 키 (선택사항)
# ========================================
# Naver
NAVER_CLIENT_ID=your_naver_client_id
NAVER_CLIENT_SECRET=your_naver_client_secret

# Kakao
KAKAO_REST_API_KEY=your_kakao_rest_api_key
KAKAO_JAVASCRIPT_KEY=your_kakao_javascript_key
KAKAO_ADMIN_KEY=your_kakao_admin_key

# Google
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Facebook
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret

# Twitter
TWITTER_API_KEY=your_twitter_api_key
TWITTER_API_SECRET=your_twitter_api_secret

# Payco
PAYCO_CLIENT_ID=your_payco_client_id
PAYCO_CLIENT_SECRET=your_payco_client_secret

# ========================================
# PG 결제 API 키 (선택사항)
# ========================================
# Inicis
INICIS_MID=your_inicis_mid
INICIS_SIGNKEY=your_inicis_signkey

# LG U+
LGUP_MID=your_lgup_mid
LGUP_HASHKEY=your_lgup_hashkey

# KCP
KCP_SITE_CD=your_kcp_site_cd
KCP_SITE_KEY=your_kcp_site_key

# Kakaopay
KAKAOPAY_CID=your_kakaopay_cid
KAKAOPAY_ADMIN_KEY=your_kakaopay_admin_key

# Nicepay
NICEPAY_MID=your_nicepay_mid
NICEPAY_MERCHANTKEY=your_nicepay_merchantkey

# ========================================
# 보안 설정
# ========================================
# 세션 타임아웃 (초 단위, 기본 2시간)
SESSION_LIFETIME=7200

# 로그인 실패 최대 횟수
MAX_LOGIN_ATTEMPTS=5

# 로그인 실패 잠금 시간 (초 단위, 기본 30분)
LOGIN_LOCKOUT_TIME=1800
