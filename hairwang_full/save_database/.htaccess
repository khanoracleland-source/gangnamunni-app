# 기본 보안 설정

# 디렉토리 목록 차단
Options -Indexes

# PHP 파일 실행 허용
<Files "\.php$">
    Order Allow,Deny
    Allow from all
</Files>

# 숨김 파일 접근 차단
<FilesMatch "^\.">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# 백업 폴더 접근 제한
<Files "dbbackup/">
    Order Allow,Deny
    Deny from all
</Files>

# 보안 헤더
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
</IfModule>

# 캐시 비활성화
<IfModule mod_expires.c>
    ExpiresActive Off
</IfModule>
