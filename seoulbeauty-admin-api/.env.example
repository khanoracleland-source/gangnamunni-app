# Copy to .env (chmod 640 root:sbapi) and fill in on the server. No real values in this file.

# Master switch. Anything but 1 = off: every /v1 route answers 404 {"error":"not_found"} (only /health works).
ADMIN_PANEL_ENABLED=0

# MariaDB. Use a DEDICATED user that has SELECT only, and only on the tables the dashboard reads
# (exact GRANTs: deploy/README.md). This API never writes; do not reuse a user with write rights.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
# Schema name. Code default when empty: gangnamunni. The real name is server-specific: confirm it first
# (deploy/README.md step 1) and use the same name in the GRANTs.
DB_NAME=
DB_POOL=5

# Listen address (systemd sets both; defaults 127.0.0.1:3300). Never bind a public interface.
HOST=127.0.0.1
PORT=3300
# Number of proxy hops in front of this API, so rate limiting sees the real client IP
# (browser -> Cloudflare -> Apache -> admin web (Next) -> this API).
TRUST_PROXY=
RATE_LIMIT_PER_MIN=120

# PHP admin session authority (gangnamunni/api/admin_session_me.php). The browser Cookie header is forwarded server-side.
# Default: the public URL, which needs the server to reach its own hostname. Loopback alternative:
#   ADMIN_PHP_SESSION_URL=http://127.0.0.1/<path to gangnamunni>/api/admin_session_me.php
#   ADMIN_PHP_SESSION_HOST=seoulbeauty.app
# With ADMIN_PHP_SESSION_HOST set, that Host header and X-Forwarded-Proto: https are sent, so Apache picks the right vhost
# and does not redirect the loopback request to HTTPS. It must be the host admins use for the PHP admin pages.
ADMIN_PHP_SESSION_URL=
ADMIN_PHP_SESSION_HOST=
# How long one answer is reused per cookie, in ms. Capped at 5000 (0 = ask PHP on every request).
ADMIN_PHP_SESSION_CACHE_MS=5000
