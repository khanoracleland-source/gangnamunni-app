# Copy to .env (chmod 640 root:sbapi) and fill in on the server. No real values in this file.

# Master switch. Anything but 1 = off: every /v1 route answers 404 {"error":"not_found"} (only /health works).
ADMIN_PANEL_ENABLED=0
# Hospital pages (/v1/hospitals*) and the entry of hospital roles (hospital_super_admin, hospital_admin; own hospital only).
# Anything but 1 = off: those routes answer 404 and hospital roles get 403 everywhere. Needs the extra GRANTs in deploy/README.md.
ADMIN_HOSPITALS_ENABLED=0
# Editing hospitals (PATCH /v1/hospitals/:id, .../active, .../revisions/review). Needs ADMIN_HOSPITALS_ENABLED=1 and the write user below
# (deploy/README.md section 6). Anything but 1 = off: those routes answer 404 and no write connection is opened.
ADMIN_HOSPITALS_WRITE=0
# Deleting hospitals (super admin) and the archive of deleted ones. Needs ADMIN_HOSPITALS_ENABLED=1 and ADMIN_HOSPITALS_WRITE=1, the archive table
# (deploy/sql/hospital_deletions.sql) and the GRANTs of deploy/README.md section 7. Anything but 1 = off: those routes answer 404.
ADMIN_HOSPITALS_DELETE=0
# Approving / rejecting hospital applications (POST /v1/hospitals/:id/approve and /reject; super admin; changes the status only, no account or e-mail). Needs
# ADMIN_HOSPITALS_ENABLED=1 and ADMIN_HOSPITALS_WRITE=1 and the GRANTs of deploy/README.md section 12. Anything but 1 = off: both routes answer 404.
ADMIN_HOSPITALS_REVIEW=0
# Uploading hospital images (GET/POST /v1/hospitals/:id/images). Needs ADMIN_HOSPITALS_ENABLED=1 and ADMIN_HOSPITALS_WRITE=1, the GRANTs and the
# writable upload folder of deploy/README.md section 8. Anything but 1 = off: the upload route answers 404.
ADMIN_HOSPITALS_IMAGES=0
# Uploading, replacing and deleting the submitted documents of a hospital (POST/DELETE /v1/hospitals/:id/documents/business|medical; files go to
# <ADMIN_UPLOAD_ROOT>/uploads/hospital_apply/hospital_<id>/). Needs ADMIN_HOSPITALS_ENABLED=1 and ADMIN_HOSPITALS_WRITE=1, the GRANTs and the writable folder of
# deploy/README.md section 11. Anything but 1 = off: both routes answer 404 and the detail reports documentsEditable=false.
ADMIN_HOSPITALS_DOCUMENTS=0
# Adding doctors (GET/POST /v1/hospitals/:id/doctors; photos use ADMIN_UPLOAD_ROOT below). Needs ADMIN_HOSPITALS_ENABLED=1 and ADMIN_HOSPITALS_WRITE=1,
# the GRANTs of deploy/README.md section 9 (and the upload folder of section 8 for photos). Anything but 1 = off: the add route answers 404.
ADMIN_HOSPITALS_DOCTORS=0
# Treatments of a hospital (GET/POST /v1/hospitals/:id/treatments, PATCH .../treatments/:htId: assign, promotion, minimum age). Needs ADMIN_HOSPITALS_ENABLED=1 and
# ADMIN_HOSPITALS_WRITE=1 and the GRANTs of deploy/README.md section 10. Anything but 1 = off: every treatments route answers 404.
ADMIN_HOSPITALS_TREATMENTS=0
# Removing an assignment (DELETE .../treatments/:htId; it also deletes that assignment's price option and detail image rows). Only counts while ADMIN_HOSPITALS_TREATMENTS=1.
# Needs the extra DELETE GRANTs of section 10.2. Anything but 1 = off: the DELETE route answers 404.
ADMIN_HOSPITALS_TREATMENTS_REMOVE=0
# Editing the price options of an assignment (PUT .../treatments/:htId/prices; replaces all of its price option rows). Only counts while ADMIN_HOSPITALS_TREATMENTS=1.
# Needs the extra INSERT / DELETE GRANTs of section 10.4. Anything but 1 = off: the price route answers 404.
ADMIN_HOSPITALS_TREATMENTS_PRICES=0
# Editing the "before treatment" questions of an assignment (PUT .../treatments/:htId/questions; replaces all of its question rows). Only counts while ADMIN_HOSPITALS_TREATMENTS=1.
# Needs the extra GRANTs of section 10.5. Anything but 1 = off: the questions route answers 404.
ADMIN_HOSPITALS_TREATMENTS_QUESTIONS=0
# Detail images of an assignment (GET/POST .../treatments/:htId/images, DELETE .../images/:imageId, POST .../images/:imageId/move and .../review). Only counts while ADMIN_HOSPITALS_TREATMENTS=1.
# Needs the extra GRANTs and the upload folder uploads/treatments of section 10.6 (a file upload also needs ADMIN_UPLOAD_ROOT below; an image address does not).
# Anything but 1 = off: the image routes answer 404.
ADMIN_HOSPITALS_TREATMENTS_IMAGES=0
# Treatment master pages (GET /v1/treatments: every treatment, alias, category and conflict pair; super admin only). Independent of the hospital switches.
# Needs the GRANTs of deploy/README.md section 13.1. Anything but 1 = off: /v1/treatments*, /v1/treatment-categories*, /v1/treatment-conflicts* and
# /v1/treatment-settings* answer 404 and /v1/me reports treatments=false.
ADMIN_TREATMENTS_ENABLED=0
# Editing the treatment master (treatments, aliases, categories, conflict pairs, home table mode). Needs ADMIN_TREATMENTS_ENABLED=1, the write user DB_RW_*
# below and the GRANTs of section 13.2. Anything but 1 = off: the writing routes answer 404 and the page is read-only.
ADMIN_TREATMENTS_WRITE=0
# Uploading the default image of a treatment (POST /v1/treatments/:id/image; files go to <ADMIN_UPLOAD_ROOT>/uploads/treatments/, the folder of section 10.6).
# Needs ADMIN_TREATMENTS_WRITE=1. Anything but 1 = off: the upload route answers 404 (an image address can still be typed in).
ADMIN_TREATMENTS_IMAGES=0
# Price units (GET /v1/treatment-units: the units of the price forms; super admin only). Independent of the other switches.
# Needs the GRANTs of deploy/README.md section 16. Anything but 1 = off: /v1/treatment-units* answer 404 and /v1/me reports treatmentUnits=false.
ADMIN_TREATMENT_UNITS_ENABLED=0
# Adding and removing units (POST /v1/treatment-units, DELETE /v1/treatment-units/:id; the removal is a soft delete). Needs ADMIN_TREATMENT_UNITS_ENABLED=1,
# the write user DB_RW_* below and the GRANTs of section 16. Anything but 1 = off: the writing routes answer 404 and the page is read-only.
ADMIN_TREATMENT_UNITS_WRITE=0
# Booking management (GET /v1/bookings*, export). Hospital roles also need ADMIN_HOSPITALS_ENABLED=1. Needs the GRANTs of deploy/README.md section 17.
# Anything but 1 = off: /v1/bookings* answer 404 and /v1/me reports bookings=false.
ADMIN_BOOKINGS_ENABLED=0
# Assigning doctors and moving a booking to its next status (POST /v1/bookings/:id/doctor, /v1/bookings/:id/status). Needs ADMIN_BOOKINGS_ENABLED=1 and the write user DB_RW_*.
# A confirmation also creates the payment order and tells the member (in-app + push); the push needs FCM_SERVICE_ACCOUNT_PATH. Anything but 1 = off.
ADMIN_BOOKINGS_WRITE=0
# Payment fee rates (GET/POST /v1/payments/fee-rates): the 수수료율 per payment method, set by a super admin only. Needs ADMIN_PAYMENTS_ENABLED=1, the write user DB_RW_*
# and the table + GRANTs of hairwang_full/gangnamunni/sql/payment_fee_rates.sql. Anything but 1 = off: both routes answer 404.
ADMIN_PAYMENTS_FEES=0
# Reserved for the future points system (awarding points on completion). Has no effect yet.
ADMIN_BOOKINGS_POINTS=0
# Firebase service account JSON used for the member push (same Firebase project as the app). Empty = no push, the in-app message is still stored.
FCM_SERVICE_ACCOUNT_PATH=
FCM_EXPECTED_PROJECT_ID=hospital-8425b
PHP_PUBLIC_SITE_URL=https://seoulbeauty.app/
# Absolute path of the PHP "gangnamunni" directory; files are stored in <ADMIN_UPLOAD_ROOT>/uploads/hospitals/<id>/ (treatment detail images: <ADMIN_UPLOAD_ROOT>/uploads/treatments/). Checked on every upload:
# empty, relative or not writable -> 503 {"error":"uploads_unavailable"}.
ADMIN_UPLOAD_ROOT=

# MariaDB. Use a DEDICATED user that has SELECT only, and only on the tables the dashboard reads
# (exact GRANTs: deploy/README.md). This user never writes; do not give it write rights (editing uses DB_RW_* below).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
# Schema name. Code default when empty: gangnamunni. The real name is server-specific: confirm it first
# (deploy/README.md step 1) and use the same name in the GRANTs.
DB_NAME=
DB_POOL=5
# Write user (sb_admin_rw), used only when ADMIN_HOSPITALS_WRITE=1; the connection is opened lazily on the first write.
# Same host / port / schema as above. Without it, writes answer 503 {"error":"write_unavailable"}.
DB_RW_USER=
DB_RW_PASSWORD=
DB_RW_POOL=2

# Listen address (systemd sets both; defaults 127.0.0.1:3300). Never bind a public interface.
HOST=127.0.0.1
PORT=3300
# Number of proxy hops in front of this API, so rate limiting sees the real client IP
# (browser -> Cloudflare -> Apache -> admin web (Next) -> this API).
TRUST_PROXY=
RATE_LIMIT_PER_MIN=120

# PHP admin session authority (gangnamunni/api/admin_session_me.php). The browser Cookie header is forwarded server-side.
# Default: the public URL, which needs the server to reach its own hostname. Loopback alternative:
#   ADMIN_PHP_SESSION_URL=http://127.0.0.1/<path to gangnamunni>/api/admin_session_me.php
#   ADMIN_PHP_SESSION_HOST=seoulbeauty.app
# With ADMIN_PHP_SESSION_HOST set, that Host header and X-Forwarded-Proto: https are sent, so Apache picks the right vhost
# and does not redirect the loopback request to HTTPS. It must be the host admins use for the PHP admin pages.
ADMIN_PHP_SESSION_URL=
ADMIN_PHP_SESSION_HOST=
# How long one answer is reused per cookie, in ms. Capped at 5000 (0 = ask PHP on every request).
ADMIN_PHP_SESSION_CACHE_MS=5000

# Registering a hospital by a super admin (GET /v1/hospital-apply/options, GET .../phone-check, POST /v1/hospital-apply; multipart). Independent of the hospital
# switches; needs the write user DB_RW_*, ADMIN_UPLOAD_ROOT and the GRANTs of deploy/README.md section 14. The hospital is stored approved and inactive.
# Anything but 1 = off: every /v1/hospital-apply route answers 404 and /v1/me reports hospitalApply=false.
ADMIN_HOSPITAL_APPLY_ENABLED=0
# Admin accounts page (GET /v1/admins, /v1/admins/options, /v1/admins/:id; read-only). A super admin sees every account, other roles only their own.
# Needs the migration and the GRANTs of deploy/README.md section 15. Anything but 1 = off: those routes answer 404
# and /v1/me reports admins=false.
ADMIN_ADMINS_ENABLED=0
ADMIN_ADMINS_WRITE_ENABLED=0
