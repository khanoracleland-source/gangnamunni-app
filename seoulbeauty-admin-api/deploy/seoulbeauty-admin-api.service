# /etc/systemd/system/seoulbeauty-admin-api.service
# Admin panel JSON API for Seoul Beauty (NestJS, read-only). Listens on 127.0.0.1:3300 only.
[Unit]
Description=Seoul Beauty Admin JSON API (NestJS)
After=network.target mariadb.service
Wants=mariadb.service

[Service]
Type=simple
User=sbapi
Group=sbapi
WorkingDirectory=/var/www/html/multi-hospital-management-system-saas-hospital/hms-saas-v5.8.0/hms-saas/seoulbeauty-admin-api
# .env is loaded by node itself (--env-file-if-exists); keep it chmod 640 root:sbapi
ExecStart=/usr/bin/node --env-file-if-exists=.env dist/main.js
Restart=on-failure
RestartSec=3
Environment=NODE_ENV=production
# systemd env wins over .env, so the address is fixed here
Environment=PORT=3300
Environment=HOST=127.0.0.1
# Hardening: the service writes nothing to disk
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/var/www/html/multi-hospital-management-system-saas-hospital/hms-saas-v5.8.0/hms-saas/seoulbeauty-admin-api
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
