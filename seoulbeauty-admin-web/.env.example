# Admin NestJS API (target of the /api rewrite). Empty = http://127.0.0.1:3300
API_BASE=
# URL prefix the app is served under (Apache ProxyPass /admin-next). Empty = /admin-next
NEXT_BASE_PATH=/admin-next
# PHP admin dashboard: login redirect, "기존 관리자" link, logout (?logout=1). Read at build time.
NEXT_PUBLIC_ADMIN_PHP_LOGIN_URL=
