# MariaDB user: SELECT on everything + writes ONLY on the two tables the API mutates
# (see deploy/README.md for the exact GRANTs). Never a user with broad write rights.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=sb_api_ro
DB_PASSWORD=change-me
DB_NAME=hms_saas
DB_POOL=10
PORT=3100
# Number of proxy hops in front of Nest, so rate limiting sees the real client IP.
# Production chain: browser -> Cloudflare -> Apache -> Next -> Nest = 2 (verified: with 1 the log showed Cloudflare IPs).
TRUST_PROXY=2
RATE_LIMIT_PER_MIN=120
# Comma separated allowed origins for the Next.js frontend
CORS_ORIGINS=http://localhost:3000,https://seoulbeauty.app
# PHP session authority (api/session_me.php). The browser Cookie header is forwarded server-side.
# Public URL needs the server to reach its own hostname (hairpin NAT). If /health says
# phpSession=unreachable, use loopback + Host instead:
#   PHP_SESSION_URL=http://127.0.0.1/api/session_me.php
#   PHP_SESSION_HOST=hms.seoulbeauty.app
PHP_SESSION_URL=https://hms.seoulbeauty.app/api/session_me.php
PHP_SESSION_HOST=
# After logout the API may still see the old session for up to this long.
PHP_SESSION_CACHE_MS=10000
# Community photo uploads (absolute dir writable by the sbapi group, and the public URL prefix stored in the DB).
# Must be the same folder Apache serves at COMMUNITY_UPLOAD_URL (PHP used /hairwang/app/uploads/community/).
COMMUNITY_UPLOAD_DIR=
COMMUNITY_UPLOAD_URL=/hairwang/app/uploads/community/
# 마이페이지: profile photos (PHP uploads/profile). Read for the avatar, and written by POST /v1/mypage/profile: the dir must be writable by the sbapi group and listed in the systemd ReadWritePaths drop-in. Leave empty to show the initial instead.
PROFILE_PHOTO_DIR=
PROFILE_PHOTO_URL=/hairwang/gangnamunni/uploads/profile/
# Points row on 마이페이지 (PHP: includes/points_pause.php POINTS_MENU_HIDDEN = true means hidden). Set true to show it again.
MYPAGE_POINTS_VISIBLE=false
# 후기 작성 (POST /v1/mypage/reviews): photos go to <REVIEW_UPLOAD_DIR>/<review id>/. Absolute path of gangnamunni/uploads/reviews;
# the sbapi group must be able to write it and it must be listed in the systemd ReadWritePaths drop-in, otherwise photos are not saved.
REVIEW_UPLOAD_DIR=
# Optional: reviews a member may submit per 10 minutes (default 10).
REVIEW_RATE_MAX=
# New-review notice to admins: FCM HTTP v1 service account (JSON readable by the sbapi group) and the project it must belong to.
# Without a readable file push is skipped (in-app notices and the send log still work).
FCM_SERVICE_ACCOUNT_PATH=
FCM_EXPECTED_PROJECT_ID=hospital-8425b
# 경과 후기 (POST /v1/mypage/progress/:id/entries): photos go to <PROGRESS_UPLOAD_DIR>/<entry id>/ (gangnamunni/uploads/progress; blocked
# from direct URL access by uploads/.htaccess, so the API serves them itself). sbapi group write + ReadWritePaths like the other upload dirs.
PROGRESS_UPLOAD_DIR=
# Booking → HMS appointment (includes/infyhms_api.php). Without these a booking is saved but not sent to HMS.
HMS_API_URL=http://127.0.0.1:8000/api/external
HMS_API_KEY=
# Booking payment switches (mirror hairwang_full/data/dbconfig.php).
# PG_PAYMENTS_ENABLED=1 turns card checkout on, but only when INICIS_* and DB_PAY_* below are ALL set (see deploy/README.md "Inicis").
PG_PAYMENTS_ENABLED=0
BOOKING_PAYMENT_METHODS=

# Mail (password reset): Mailcow admin@ account, SMTP submission with STARTTLS (same as PHP includes/mail_helper.php)
SMTP_HOST=mail.seoulbeauty.app
SMTP_PORT=587
SMTP_USER=admin@seoulbeauty.app
SMTP_PASSWORD=
SMTP_FROM_NAME=Seoul Beauty Admin

# Session-mint bridge shared with PHP (gangnamunni/.env has the same value). >= 32 chars; empty = sign-up/login via Nest cannot create a session.
SESSION_BRIDGE_SECRET=
# Public base of the web app (with /next) used for links in mails (password reset). Default https://hms.seoulbeauty.app/next
PUBLIC_SITE_URL=
# 예약 · 결제 알림 to members (links in the in-app row and the push are absolute, like PHP's SITE_FULL_URL; default https://seoulbeauty.app/)
PHP_PUBLIC_SITE_URL=
# 방문 전 알림 (설정 > noti_visit): in-process job, every N minutes from 10:00 KST. Set VISIT_REMINDER_ENABLED=0 on a second API instance.
VISIT_REMINDER_ENABLED=1
VISIT_REMINDER_INTERVAL_MIN=15
# Push token housekeeping (replaces PHP cron_push_token_cleanup.php): 1 = once a day in this KST hour. Needs the grants in deploy/README.md.
PUSH_TOKEN_CLEANUP_ENABLED=
PUSH_TOKEN_CLEANUP_HOUR=0
# [05-37] 결제 기한 자동 취소: 1 = a confirmed booking that is still unpaid payment_deadline_hours after the confirmation is cancelled
# (only where the member could pay: a pending order + checkout open for that member). Check first: npm run payment-expire -- --dry-run
PAYMENT_EXPIRE_ENABLED=
PAYMENT_EXPIRE_INTERVAL_MIN=10
# DEV ONLY: off = no rate limits on password-reset mails and the temporary-password check. Works ONLY when NODE_ENV=development or test
# (ignored for production, any other value, or no NODE_ENV).
PASSWORD_LOST_RATE_LIMIT=
# TESTING ON THE LIVE SERVER: the reset limits are skipped only when the request comes from one of PASSWORD_LOST_TEST_IPS (your own public IP)
# with one of PASSWORD_LOST_TEST_EMAILS (max 3 each), and only until PASSWORD_LOST_TEST_UNTIL (ISO time, at most 24 h ahead; else ignored).
PASSWORD_LOST_TEST_EMAILS=
PASSWORD_LOST_TEST_IPS=
PASSWORD_LOST_TEST_UNTIL=
# Social login on Nest (D4): comma list of kakao,google,apple. Empty = PHP flow.
# apple needs the Return URL <SOCIAL_CALLBACK_BASE>/apple/callback on the Apple Services ID (deploy/README.md, D4c).
SOCIAL_NEST_PROVIDERS=
SOCIAL_CALLBACK_BASE=
SOCIAL_PHP_BASE=
# D4b: 1 = a social profile that is not linked yet is registered by Nest (Kakao at once, Google through /next/register/social).
# Empty = the PHP flow registers it (rollback switch).
SOCIAL_NEST_REGISTER=

# KG Inicis (INIPayPro) card payment. Secrets live ONLY here (server .env), never in git or the Next bundle.
# INICIS_MODE=test needs one of Inicis' public test MIDs (INIpayTest ...): they really approve and are cancelled at midnight, rows are booked
# as provider `inicis_test` (excluded from settlement). INICIS_MODE=live needs the real MID (a test MID is refused).
INICIS_MID=
# "모바일 금액위변조 Hash Key" (Inicis merchant admin > 상점정보 > 계약정보 > KEY 정보)
INICIS_HASHKEY=
INICIS_MODE=test
# Test mode really charges cards (cancelled at midnight): ONLY these members (comma separated mb_id) can see and use checkout. Ignored in live mode.
INICIS_TEST_MEMBERS=
# Live mode charges real money: ONLY these members (mb_id, comma separated) see checkout. Empty = nobody. `*` = everyone (public launch).
INICIS_LIVE_MEMBERS=
# Public https base including the Next basePath: P_NEXT_URL = <base>/api/v1/payments/inicis/return (https only: Android drops an http one)
INICIS_PUBLIC_BASE=https://hms.seoulbeauty.app/next
# URL scheme the iOS card apps return to (Flutter app: wellness)
INICIS_APP_SCHEME=wellness
# The dedicated MariaDB account that may mark an order paid (the general API user cannot). See deploy/README.md "Inicis".
DB_PAY_USER=
DB_PAY_PASSWORD=
DB_PAY_POOL=8
# Optional. Money-at-risk events (net cancel failed, card charged but ledger not updated, approval outcome unknown) are always logged as
# `[inicis][ALERT][CODE] ...`; set an https URL (Slack-compatible incoming webhook, JSON {"text": ...}) to be told at once.
INICIS_ALERT_WEBHOOK=
# Optional. One call to Inicis (approval / net cancel), ms, clamped 3000..30000. Default 10000.
INICIS_TIMEOUT_MS=10000
# Optional. Extra public test MIDs (comma separated), if Inicis adds one; they are treated as test MIDs (refused in live mode).
INICIS_EXTRA_TEST_MIDS=
# Optional. Per-IP limit of POST /v1/payments/inicis/return per minute (a real customer posts once per payment). Default 20.
INICIS_RETURN_RATE_PER_MIN=20

# Kakao developers > 앱 키 > Admin 키: withdraws a Kakao member's consent (/v1/user/unlink) before the account is deleted.
KAKAO_ADMIN_KEY=
