# Read-only MariaDB user is strongly recommended (GRANT SELECT only).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=sb_api_ro
DB_PASSWORD=change-me
DB_NAME=hms_saas
DB_POOL=10
PORT=3100
# Behind nginx/Apache set TRUST_PROXY=1 so rate limiting sees the real client IP
TRUST_PROXY=1
RATE_LIMIT_PER_MIN=120
# Comma separated allowed origins for the Next.js frontend
CORS_ORIGINS=http://localhost:3000,https://seoulbeauty.app
# PHP session authority (api/session_me.php). The browser Cookie header is forwarded server-side.
# Public URL needs the server to reach its own hostname (hairpin NAT). If /health says
# phpSession=unreachable, use loopback + Host instead:
#   PHP_SESSION_URL=http://127.0.0.1/api/session_me.php
#   PHP_SESSION_HOST=hms.seoulbeauty.app
PHP_SESSION_URL=https://hms.seoulbeauty.app/api/session_me.php
PHP_SESSION_HOST=
# After logout the API may still see the old session for up to this long.
PHP_SESSION_CACHE_MS=10000
