# MariaDB user: SELECT on everything + writes ONLY on the two tables the API mutates
# (see deploy/README.md for the exact GRANTs). Never a user with broad write rights.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=sb_api_ro
DB_PASSWORD=change-me
DB_NAME=hms_saas
DB_POOL=10
PORT=3100
# Number of proxy hops in front of Nest, so rate limiting sees the real client IP.
# Production chain: browser -> Cloudflare -> Apache -> Next -> Nest = 2 (verified: with 1 the log showed Cloudflare IPs).
TRUST_PROXY=2
RATE_LIMIT_PER_MIN=120
# Comma separated allowed origins for the Next.js frontend
CORS_ORIGINS=http://localhost:3000,https://seoulbeauty.app
# PHP session authority (api/session_me.php). The browser Cookie header is forwarded server-side.
# Public URL needs the server to reach its own hostname (hairpin NAT). If /health says
# phpSession=unreachable, use loopback + Host instead:
#   PHP_SESSION_URL=http://127.0.0.1/api/session_me.php
#   PHP_SESSION_HOST=hms.seoulbeauty.app
PHP_SESSION_URL=https://hms.seoulbeauty.app/api/session_me.php
PHP_SESSION_HOST=
# After logout the API may still see the old session for up to this long.
PHP_SESSION_CACHE_MS=10000
# Community photo uploads (absolute dir writable by the sbapi group, and the public URL prefix stored in the DB).
# Must be the same folder Apache serves at COMMUNITY_UPLOAD_URL (PHP used /hairwang/app/uploads/community/).
COMMUNITY_UPLOAD_DIR=
COMMUNITY_UPLOAD_URL=/hairwang/app/uploads/community/
# 마이페이지: profile photos (PHP uploads/profile). Read for the avatar, and written by POST /v1/mypage/profile: the dir must be writable by the sbapi group and listed in the systemd ReadWritePaths drop-in. Leave empty to show the initial instead.
PROFILE_PHOTO_DIR=
PROFILE_PHOTO_URL=/hairwang/gangnamunni/uploads/profile/
# Points row on 마이페이지 (PHP: includes/points_pause.php POINTS_MENU_HIDDEN = true means hidden). Set true to show it again.
MYPAGE_POINTS_VISIBLE=false
# 후기 작성 (POST /v1/mypage/reviews): photos go to <REVIEW_UPLOAD_DIR>/<review id>/. Absolute path of gangnamunni/uploads/reviews;
# the sbapi group must be able to write it and it must be listed in the systemd ReadWritePaths drop-in, otherwise photos are not saved.
REVIEW_UPLOAD_DIR=
# Optional: reviews a member may submit per 10 minutes (default 10).
REVIEW_RATE_MAX=
# New-review notice to admins: FCM HTTP v1 service account (JSON readable by the sbapi group) and the project it must belong to.
# Without a readable file push is skipped (in-app notices and the send log still work).
FCM_SERVICE_ACCOUNT_PATH=
FCM_EXPECTED_PROJECT_ID=hospital-8425b
# 경과 후기 (POST /v1/mypage/progress/:id/entries): photos go to <PROGRESS_UPLOAD_DIR>/<entry id>/ (gangnamunni/uploads/progress; blocked
# from direct URL access by uploads/.htaccess, so the API serves them itself). sbapi group write + ReadWritePaths like the other upload dirs.
PROGRESS_UPLOAD_DIR=
# Booking → HMS appointment (includes/infyhms_api.php). Without these a booking is saved but not sent to HMS.
HMS_API_URL=http://127.0.0.1:8000/api/external
HMS_API_KEY=
# Booking payment switches (mirror hairwang_full/data/dbconfig.php). Live PG checkout stays in PHP until it is ported.
PG_PAYMENTS_ENABLED=0
BOOKING_PAYMENT_METHODS=
BOOKING_PAYMENT_PREVIEW_ENABLED=1

# Mail (password reset): Mailcow admin@ account, SMTP submission with STARTTLS (same as PHP includes/mail_helper.php)
SMTP_HOST=mail.seoulbeauty.app
SMTP_PORT=587
SMTP_USER=admin@seoulbeauty.app
SMTP_PASSWORD=
SMTP_FROM_NAME=Seoul Beauty Admin

# Session-mint bridge shared with PHP (gangnamunni/.env has the same value). >= 32 chars; empty = sign-up/login via Nest cannot create a session.
SESSION_BRIDGE_SECRET=
# Social login on Nest (D4): comma list of kakao,google. Empty = PHP flow.
SOCIAL_NEST_PROVIDERS=
SOCIAL_CALLBACK_BASE=
SOCIAL_PHP_BASE=
# D4b: 1 = a social profile that is not linked yet is registered by Nest (Kakao at once, Google through /next/register/social).
# Empty = the PHP flow registers it (rollback switch).
SOCIAL_NEST_REGISTER=
