# /etc/systemd/system/seoulbeauty-api.service
# Read-only JSON API for Seoul Beauty (NestJS). Listens on 127.0.0.1:3110 only.
[Unit]
Description=Seoul Beauty JSON API (NestJS)
After=network.target mariadb.service
Wants=mariadb.service

[Service]
Type=simple
User=sbapi
Group=sbapi
WorkingDirectory=/var/www/html/multi-hospital-management-system-saas-hospital/hms-saas-v5.8.0/hms-saas/seoulbeauty-api
# .env is loaded by node itself (--env-file-if-exists); keep it chmod 640 root:sbapi
ExecStart=/usr/bin/node --env-file-if-exists=.env dist/main.js
Restart=on-failure
RestartSec=3
Environment=NODE_ENV=production
# App default is 3100; systemd env wins over .env, so the port is fixed here
Environment=PORT=3110
Environment=HOST=127.0.0.1
# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/var/www/html/multi-hospital-management-system-saas-hospital/hms-saas-v5.8.0/hms-saas/seoulbeauty-api
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
