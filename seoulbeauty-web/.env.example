# NestJS API (server-side + /api rewrite target)
API_BASE=http://127.0.0.1:3110
# Where hospital images (uploads/...) are served from (the PHP site)
NEXT_PUBLIC_ASSET_BASE=https://seoulbeauty.app
PORT=3200
# URL prefix the app is served under (Apache ProxyPass /next/). Both must match.
NEXT_BASE_PATH=/next
NEXT_PUBLIC_BASE_PATH=/next
# `npm start` binds to 127.0.0.1 only; put Apache/nginx in front.
